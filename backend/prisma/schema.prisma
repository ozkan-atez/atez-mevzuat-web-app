/// A discovered URL is evidence only after it is explicitly activated.
model SourceEndpoint {
  id              String   @id @default(uuid())
  sourceId        String
  url             String
  title           String
  reason          String?
  keywords        String?
  status          String   @default("PROPOSED")
  adapter         String?
  managedSourceId String?
  discoveredAt    DateTime @default(now())
  updatedAt       DateTime @updatedAt

  source Source @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  @@index([sourceId, status])
  @@unique([sourceId, url])
}

model SourceScanRun {
  workspaceId String?
  initiatorUserId String?
  workspace Workspace? @relation(fields:[workspaceId],references:[id],onDelete:Restrict)
  initiator User? @relation("SourceScanRunInitiator",fields:[initiatorUserId],references:[id],onDelete:Restrict)
  stages SourceRunStage[]
  profileSnapshot Json?
  coverage Json?
  datePolicy String @default("PUBLISHED_DATE")
  processingScanRunId String? @unique
  queueVersion Int @default(0)
  queueDispatchedAt DateTime?
  operations OperationRequest[]
  id          String    @id @default(uuid())
  sourceId    String
  scanRunId   String?
  requestKey  String    @unique
  targetDate  DateTime  @db.Date
  trigger     String    @default("MANUAL")
  scheduleSlot String?
  status      String    @default("QUEUED")
  errorSummary String?
  reportHtml  String?
  startedAt   DateTime?
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  source    Source @relation(fields: [sourceId], references: [id], onDelete: Restrict)
  scanRun   ScanRun? @relation(fields: [scanRunId], references: [id], onDelete: Cascade)
  documents SourceScanDocument[]

  @@index([targetDate, createdAt])
  @@index([scanRunId])
  @@index([status, createdAt])
}

model SourceScanDocument {
  captureStatus String @default("PENDING")
  captureError String?
  capturedFiles Json?
  filterDecision String?
  filterReason String?
  processingStatus String @default("PENDING")
  processingError String?
