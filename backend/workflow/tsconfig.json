{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2023"],
    "types": ["node"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": false,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "noEmit": true
  },
  "include": ["apps/*/src/**/*.ts", "packages/*/src/**/*.ts", "packages/*/test/**/*.ts", "apps/*/test/**/*.ts", "test/**/*.ts", "*.ts", "packages/*/*.ts"],
  "exclude": ["apps/web/**"]
}
