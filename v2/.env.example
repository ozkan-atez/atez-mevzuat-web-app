# --- Veritabanı ---
DATABASE_URL=postgres://atez:atez-local@127.0.0.1:55432/atez_v2
# Testler yalnızca bu adrese bağlanır; ad _test ile bitmek zorunda.
TEST_DATABASE_URL=postgres://atez:atez-local@127.0.0.1:55432/atez_v2_test

# --- RabbitMQ (uygulamaya ait vhost) ---
AMQP_URL=amqp://atez:atez-local@127.0.0.1:55672/atez-mevzuat
# Testler ayrı vhost kullanır (kısa retry gecikmeleriyle kurulur).
TEST_AMQP_URL=amqp://atez:atez-local@127.0.0.1:55672/atez-mevzuat-test
RABBITMQ_MANAGEMENT_URL=http://atez:atez-local@127.0.0.1:55673

# --- MinIO ---
S3_ENDPOINT=http://127.0.0.1:55900
S3_REGION=eu-central-1
S3_BUCKET=atez-radar
S3_ACCESS_KEY_ID=atez-local
S3_SECRET_ACCESS_KEY=atez-local-secret
S3_FORCE_PATH_STYLE=true

# --- Vertex AI ---
# Servis hesabı anahtar dosyası; yolu ve içeriği repoya girmez, yalnızca .env'de durur.
GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account-key.json
# Boşsa anahtar dosyasındaki project_id kullanılır.
VERTEX_PROJECT=
# Varsayılan `global` (2026-10-17 kararı). `global` işlemenin AB içinde kalacağını garanti etmez;
# veri yerleşimi gerekirse `eu` kullanın (europe-west4 gibi tek AB bölgeleri bu modelleri sunmuyor).
VERTEX_LOCATION=global

# --- Gotenberg (DOCX/XLSX -> PDF), opsiyonel ---
GOTENBERG_URL=

# --- TARIFF (önceki değer aracı; Keycloak agsw/tarife) ---
# Yalnızca .env'de durur; repoya, loglara ve çıktılara girmez. Boşsa TARIFF stratejisi
# ERROR döner ve önceki hal RG aramasıyla aranır.
TARIFF_USERNAME=
TARIFF_PASSWORD=
