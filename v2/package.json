{
  "name": "atez-radar-v2",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p apps/web/tsconfig.json",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:int": "vitest run --project integration",
    "db:generate": "drizzle-kit generate --config packages/platform/drizzle.config.ts",
    "db:migrate": "tsx --env-file-if-exists=.env packages/platform/src/db/migrate-cli.ts",
    "infra:up": "docker compose -f docker-compose.yml up -d",
    "infra:down": "docker compose -f docker-compose.yml down",
    "worker": "tsx --env-file-if-exists=.env apps/worker/src/main.ts",
    "relay": "tsx --env-file-if-exists=.env apps/relay/src/main.ts",
    "api": "tsx --env-file-if-exists=.env apps/api/src/main.ts",
    "scheduler": "tsx --env-file-if-exists=.env apps/scheduler/src/main.ts",
    "topology:export": "tsx packages/platform/src/messaging/export-cli.ts",
    "run-once": "tsx --env-file-if-exists=.env apps/worker/src/run-once.ts",
    "web": "pnpm --filter @atez/web dev"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "drizzle-kit": "^0.30.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
