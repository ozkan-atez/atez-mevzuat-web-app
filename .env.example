DATABASE_URL=postgresql://atez:atezpassword@db:5432/atez_db?schema=public
PORT=3001
SCAN_TIMEZONE=Europe/Istanbul
SOURCE_HOSTS=resmigazete.gov.tr,www.resmigazete.gov.tr
SOURCE_DELAY_MS=750
SOURCE_TIMEOUT_MS=30000
SOURCE_MAX_ATTEMPTS=3
MAX_FILE_BYTES=104857600
MAX_RUN_BYTES=2147483648
S3_ENDPOINT=http://object-storage:9000
S3_REGION=eu-central-1
S3_BUCKET=resmi-gazete
S3_ACCESS_KEY_ID=atez-local-access
S3_SECRET_ACCESS_KEY=atez-local-secret-change-me
S3_FORCE_PATH_STYLE=true
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.7-flash
PREVIOUS_SOURCE_CONCURRENCY=3
TOPIC_ANALYSIS_CONCURRENCY=3
GEMINI_TIMEOUT_MS=30000
GEMINI_MAX_ATTEMPTS=3
GEMINI_MAX_CONTENT_BYTES=8000000

# PDF üretimi (Gotenberg)
GOTENBERG_URL=http://gotenberg:3000
GOTENBERG_TIMEOUT_MS=60000

# E-posta gönderimi (Microsoft Graph, uygulama izinleri / client credentials)
# Azure portalda uygulama kaydı > API permissions > Microsoft Graph > Application
# permissions > Mail.Send ekleyip yönetici onayı verin.
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=
# Gönderici olarak kullanılacak posta kutusu (örn. mevzuatradari@atez.com)
GRAPH_SENDER_ADDRESS=
GRAPH_SENDER_NAME=ATEZ Mevzuat Radarı
MAIL_MAX_ATTACHMENT_BYTES=3145728
