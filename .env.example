DATABASE_URL=postgresql://atez:atezpassword@db:5432/atez_db?schema=public
PORT=3001
SCAN_TIMEZONE=Europe/Istanbul
SOURCE_HOSTS=resmigazete.gov.tr,www.resmigazete.gov.tr
SOURCE_DELAY_MS=750
SOURCE_TIMEOUT_MS=30000
SOURCE_MAX_ATTEMPTS=3
MAX_FILE_BYTES=104857600
MAX_RUN_BYTES=2147483648
S3_ENDPOINT=http://object-storage:9000
S3_REGION=eu-central-1
S3_BUCKET=resmi-gazete
S3_ACCESS_KEY_ID=atez-local-access
S3_SECRET_ACCESS_KEY=atez-local-secret-change-me
S3_FORCE_PATH_STYLE=true
GEMINI_BROWSER_MODEL=gemini-3.8-flash
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.7-flash
PREVIOUS_SOURCE_CONCURRENCY=3
TOPIC_ANALYSIS_CONCURRENCY=3
GEMINI_TIMEOUT_MS=30000
GEMINI_MAX_ATTEMPTS=3
GEMINI_MAX_CONTENT_BYTES=8000000

# Additive migrations must be applied before enabling modular document/operation APIs.
# Current access boundary is local workspace; shared deployments need authenticated actor scopes.
MODULAR_OPERATIONS_ENABLED=false

# Keycloak BFF. Local values are generated by backend/scripts/setup-local-auth.cjs.
# Company profile requires explicit HTTPS issuer/origin/client and secrets; no mock fallback.
AUTH_PROFILE=local
APP_PUBLIC_ORIGIN=http://localhost:5173
OIDC_ISSUER_URL=http://localhost:45881/realms/atez-web-local
OIDC_CLIENT_ID=atez-mevzuat-web
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=http://localhost:5173/api/auth/callback
OIDC_POST_LOGOUT_REDIRECT_URI=http://localhost:5173/login
SESSION_ENCRYPTION_KEY=
SESSION_IDLE_TTL_SECONDS=1800
SESSION_ABSOLUTE_TTL_SECONDS=28800
AUTH_WORKSPACE_KEY=atez
OIDC_CA_FILE=
WORKER_ACTOR_USER_ID=

# PDF üretimi (Gotenberg)
GOTENBERG_URL=http://gotenberg:3000
GOTENBERG_TIMEOUT_MS=60000

# E-posta gönderimi (Microsoft Graph, uygulama izinleri / client credentials)
# Azure portalda uygulama kaydı > API permissions > Microsoft Graph > Application
# permissions > Mail.Send ekleyip yönetici onayı verin.
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=
# Gönderici olarak kullanılacak posta kutusu (örn. mevzuatradari@atez.com)
GRAPH_SENDER_ADDRESS=
GRAPH_SENDER_NAME=ATEZ Mevzuat Radarı
MAIL_MAX_ATTACHMENT_BYTES=3145728

# Background workers require RabbitMQ. Encode special characters in URL credentials.
RABBITMQ_URL=amqp://atez:atezpassword@127.0.0.1:5672
RABBITMQ_USER=atez
RABBITMQ_PASSWORD=atezpassword
# Docker connects to the internal rabbitmq hostname. Set RABBITMQ_DOCKER_URL for an external broker or URL-encoded credentials.

# --- Docker yığını (docker-compose.yml) ---
# Host portları; makinedeki diğer kurulumlarla çakışırsa değiştirin.
WEB_PORT=8890
KEYCLOAK_PORT=48080
DB_PORT=35432
# Sohbetin bileşen araçlarının kullandığı v2 servisi (Docker'da otomatik: http://v2-api:3100).
COMPONENT_STUDIO_URL=
# v2 (Vertex): boşsa anahtar dosyasındaki project_id kullanılır.
VERTEX_PROJECT=
VERTEX_LOCATION=global

# --- Üretim / test ortamı (docker-compose.prod.yml) ---
# IMAGE_TAG=main
# V2_DATABASE_URL=postgres://...
# V2_S3_BUCKET=atez-v2
# VERTEX_CREDENTIALS_FILE=/etc/atez/vertex-sa.json
